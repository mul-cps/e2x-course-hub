# Build the application wheel offline with the fresh UI before building this image.
# An immutable, currently deployed admin image is required; retain its dependencies.
ARG ADMIN_BASE_IMAGE
FROM ${ADMIN_BASE_IMAGE}
ARG ADMIN_BASE_IMAGE
ARG VCS_REF
LABEL org.opencontainers.image.revision=$VCS_REF
USER 0:0
COPY dist/*.whl /tmp/admin-ui/
RUN case "$ADMIN_BASE_IMAGE" in *@sha256:*) ;; *) echo 'ADMIN_BASE_IMAGE must be pinned by digest' >&2; exit 1 ;; esac \
    && python -m pip install --no-cache-dir --no-index --no-deps --force-reinstall /tmp/admin-ui/*.whl \
    && rm -rf /tmp/admin-ui
USER 10001:10001
